{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Jev Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/jev-extension"],
      "outFiles": ["${workspaceFolder}/apps/jev-extension/dist/**/*.js"],
      "preLaunchTask": "build:extension"
    }
  ]
}
