# Copy to .env and set your own key. Never commit .env.
# The key is read only by the local Jev server, never by the VS Code extension.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenRouter is an optional free-provider path. Leave empty unless using it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

JEV_HOST=127.0.0.1
JEV_PORT=8787

# Leave unset for Claude. Set to "fake" for a local stub, or "openrouter" for OpenRouter.
# JEV_PROVIDER=anthropic
