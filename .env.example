# Copy to .env and set your own key. Never commit .env.
# The key is read only by the local Jev server, never by the VS Code extension.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
JEV_HOST=127.0.0.1
JEV_PORT=8787

# Leave unset for Claude. Set to "fake" only for a local stub that is not Claude.
# JEV_PROVIDER=anthropic
